#!/usr/bin/env python3

import uuid
from datetime import datetime, timezone

from protocol import (
    emit,
    read_commands
)

from adapter import (
    run_transcriber
)



def now():

    return datetime.now(
        timezone.utc
    ).isoformat()



def main():


    emit({

        "type":"READY",

        "protocol":
            "abrxos.worker.v1",

        "time":
            now()

    })


    for command in read_commands():


        ctype=command.get(
            "type"
        )


        job_id=command.get(
            "jobId"
        )



        if ctype=="PING":

            emit({

                "type":"PONG",

                "jobId":
                    job_id

            })


        elif ctype=="TRANSCRIBE":


            emit({

                "type":"STARTED",

                "jobId":
                    job_id

            })


            result=run_transcriber(
                command
            )


            if result["code"]==0:


                emit({

                    "type":"DONE",

                    "jobId":
                        job_id,

                    "files":{

                        "json":
                            result["json"],

                        "txt":
                            result["txt"]

                    }

                })


            else:


                emit({

                    "type":"ERROR",

                    "jobId":
                        job_id,

                    "message":
                        result["stderr"]

                })


        elif ctype=="SHUTDOWN":


            emit({

                "type":"BYE"

            })

            break



if __name__=="__main__":

    main()

